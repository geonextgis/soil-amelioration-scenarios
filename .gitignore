# =============================================================================
# Project: soil-amelioration-scenarios
#
# The working tree is ~42 GB, essentially all of it SIMPLACE outputs (~34 GB
# under simplace/*/runs/) and raw remote-sensing data (~7.9 GB under
# data/raw/GLASS_LAI/). None of that belongs in Git; all of it is either a model
# output or an external input that is regenerated or re-fetched.
#
# Kept deliberately tracked (small, and the workflow depends on them):
#   data/raw/point_to_nearest_grid.csv       PointID -> grid mapping (165 KB)
#   data/raw/soil_scenarios/*.csv            the 5 amelioration scenarios
#   simplace/<crop>/data/                    model inputs (~5 MB per crop)
#   simplace/<crop>/solution/, *.py          the model and its drivers
#   simplace/<crop>/project/*_LAI.csv        LAI calibration table (~150 KB)
# =============================================================================

# --- SIMPLACE model outputs --------------------------------------------------
# Scenario run dirs (orchestration/generate.py) and calibration run dirs
# (optimization/common.py). Both are fully regenerated from config + inputs.
simplace/*/runs/
simplace/*/runs_optim/
simplace/*/out/
simplace/*/out_zip/

# Per-location output files, wherever they land.
*_daily.csv
*_yearly.csv
CheckResult.csv

# --- SIMPLACE run scaffolding (generated per submission) ---------------------
simplace/*/projects/
simplace/*/log/
simplace/*/logs/
simplace/runs_submit/
.tmp_simplace_job_*.sh
submit.log

# --- SLURM ------------------------------------------------------------------
slurm-*.out
simplace-*.out

# --- Calibration runtime state ------------------------------------------------
*.db

# --- Agentic calibration ledger ----------------------------------------------
# The ledger IS the reproducibility record, so it is tracked: ledger.jsonl,
# state.json, the freeze snapshot, optimized_baseline.json (the preserved
# pre-calibration phenology), and proposal.json / metrics.json / crop.xml per
# iteration. Only the bulky, fully re-derivable artifacts are ignored — the
# joined obs/sim frames and the figures can be regenerated from the recorded
# crop.xml, and the logs belong to a run that no longer exists.
optimization/calibration/*/iterations/*/pairs.csv.gz
optimization/calibration/*/iterations/*/season_shape.csv
optimization/calibration/*/iterations/*/diagnostics/
optimization/calibration/*/iterations/*/simplace.log
optimization/calibration/*/lai_regression/
optimization/calibration/*/adhoc/
optimization/calibration/*/history.png

# --- Large / derived datasets ------------------------------------------------
data/raw/GLASS_LAI/
data/raw/*.gpkg
data/interim/
data/processed/

# Derived model inputs, ~120 MB. Regenerated from data/raw/ by
# notebooks/01_preprocessing/:
#   data_observed/LAI_<crop>.csv        <- 02_extract_crop_specific_LAI.ipynb
#   data_observed/phenology_<crop>.csv  <- 03_phenology_data_preparation.ipynb
#   data_observed/yield_<crop>.csv      <- 01_data_preparation.ipynb
#   project/project_<crop>.csv          <- 04_prepare_simplace_project_file.ipynb
# The optimization and orchestration layers read these at runtime, so a fresh
# clone must run those notebooks before simulating.
simplace/*/data_observed/
simplace/*/project/project_*.csv
# ...except the LAI calibration table (~150 KB), which optimize_lai.py needs.
!simplace/*/project/project_*_LAI.csv

# Set-aside duplicate: verified bit-for-bit identical to simplace/winter_wheat/
# plus runs/DWD__S1. Preserved on disk under unused/, not carried in Git.
unused/simplace/winter_wheat_reference/

